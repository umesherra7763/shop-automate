# Copy this file to .env and fill in the values from Neon
# (Neon console → your project → Connect; or Vercel → Storage → your database → .env.local tab).

# Pooled connection (host contains "-pooler"), used by the app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct connection (no "-pooler"), used for migrations
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Password to open the app. Required on Vercel; optional on a home/shop computer.
APP_PASSWORD=""
